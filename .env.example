# Password players type at the door.
APP_PASSWORD=
# Password the GM types: everything players get, plus /<oneshot>/gm.
GM_PASSWORD=
# Long random string used to sign the session cookie.
AUTH_SECRET=

# Shared table claims. Put these two in .env, NOT .env.local: the Prisma CLI
# only reads .env, and an empty value in .env.local would override it for Next.
# Same Supabase project as world-gazetteer, its own Postgres schema:
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=tearoff"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=tearoff"
# Local: `pnpm db:dev` prints a TCP URL; use it for both, adding &schema=tearoff&connection_limit=1.

# Foundry table sync: shared secret for the tearoff-sync Foundry module
# (tools/foundry/tearoff-sync). Sent as `Authorization: Bearer <token>` to
# /api/foundry/tables/<code>, which is read-only. Unset = that route answers 503.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
FOUNDRY_TOKEN=

# The one-shot builder (/admin) writes content/ files only on your own machine:
# always under `pnpm dev`, and in a local production build only with this set to 1.
# Never set it on Vercel (the builder is read-only there whatever this says).
# TEAROFF_CONTENT_WRITE=1
