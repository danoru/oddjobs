generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One game night of one one-shot. The GM opens it and reads out `code`;
/// players join with the code and tear posters at this table.
model Table {
  id        String   @id @default(cuid())
  code      String   @unique
  oneshot   String
  claims     Claim[]
  deliveries Delivery[]
  flashbacks Flashback[]
  game       Game?
  recordings Recording[]
  events     TableEvent[]
  epilogue   Epilogue?
  createdAt  DateTime   @default(now())
}

/// A torn-down poster. The unique (tableId, characterId) pair is the lock:
/// once someone holds a character, nobody else at the table can tear it.
model Claim {
  id          String   @id @default(cuid())
  tableId     String
  table       Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  characterId String
  /// Random id the player's browser made up; never sent to other players.
  playerId    String
  playerName  String
  claimedAt   DateTime @default(now())

  @@unique([tableId, characterId])
}

/// A sealed letter the GM has handed to one character at this table. The
/// text stays in content; this records that it was sent and when it was opened.
/// `letterId` is a content letter id, or `beat:<from>:<n>` for a story beat
/// inherited from a character nobody is playing tonight.
model Delivery {
  id          String    @id @default(cuid())
  tableId     String
  table       Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  letterId    String
  characterId String
  deliveredAt DateTime  @default(now())
  openedAt    DateTime?

  @@unique([tableId, letterId])
}

/// A player's one-sentence answer to their character's session-zero question.
model Flashback {
  id          String   @id @default(cuid())
  tableId     String
  table       Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  characterId String
  playerId    String
  answer      String
  updatedAt   DateTime @updatedAt

  @@unique([tableId, characterId])
}

/// Live table play for systems that have it (Ten Candles): the whole game as
/// one JSON state, changed only through the system's reducer
/// (src/systems/<id>/game.ts). `version` guards against two phones acting at
/// once: a write only lands if nobody else wrote since it was read.
model Game {
  id        String   @id @default(cuid())
  tableId   String   @unique
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  system    String
  state     Json
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A player's final words (Ten Candles), kept only when the GM chooses to
/// keep recordings at this table. Small and capped: a short voice clip, or a
/// written message for players without a microphone.
model Recording {
  id        String   @id @default(cuid())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  /// The recording player's made-up browser id; never sent to anyone.
  playerId  String
  mime      String
  audio     Bytes?
  text      String?
  size      Int
  createdAt DateTime @default(now())

  @@unique([tableId, playerId])
}

/// Everything that happens at a table outside a system's own game state:
/// dice rolls, notes passed under the table, the GM's bell, act cards,
/// spotlight ticks, rumors drawn, notices pinned to the town board,
/// inspiration coins. One append-only log per table, polled with a cursor
/// (`id`); what each viewer may see is decided by `viewEvent` in
/// src/lib/live.ts, never by the client.
model TableEvent {
  id        Int      @id @default(autoincrement())
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  /// roll | note | bell | act | tick | rumor | notice | unpin | coin | spend | hide | death | candle
  kind      String
  /// The acting player's made-up browser id; null for the GM. Never sent to anyone.
  byPlayer  String?
  /// The player a note, bell, coin or rumor draw is for; null for the GM or everyone.
  toPlayer  String?
  /// A roll behind the screen: only the GM and the roller see it.
  hidden    Boolean  @default(false)
  data      Json
  createdAt DateTime @default(now())

  @@index([tableId, id])
}

/// The morning after, kept per table so the chronicle can bind every night
/// into one book: the broadsheet (headline, lines, fates) and the GM's edits
/// to the night's tapestry (panels dropped or renamed).
model Epilogue {
  id        String   @id @default(cuid())
  tableId   String   @unique
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  data      Json
  tapestry  Json
  updatedAt DateTime @updatedAt
}

/// Authored content in the database (TEAROFF_STORE=db; src/lib/store/dbStore.ts).
/// One row per one-shot, holding the builder's whole document as JSON: the
/// draft being edited and the version players see. Either may be null, never
/// both. `published` passed every check when it was written; readers parse it
/// again anyway, so a bad row can't render. Documents are `json`, not `jsonb`,
/// so their key order survives (an export reads like the files in git).
model OneShot {
  slug      String            @id
  system    String
  /// "draft" | "published" | "changed", as OneShotStatus.
  status    String
  /// The OneShotDoc being edited; null when there are no unpublished edits.
  draft     Json?             @db.Json
  /// The OneShotDoc players see; null until first published.
  published Json?             @db.Json
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  history   OneShotRevision[]
}

/// A one-shot's history: what was saved, published, unpublished, imported,
/// discarded or restored, with the whole document at that moment. Autosaves
/// within a minute of each other share one row. Restoring one makes its
/// document the draft again.
model OneShotRevision {
  id        String   @id @default(cuid())
  slug      String
  oneshot   OneShot  @relation(fields: [slug], references: [slug], onDelete: Cascade)
  /// "save" | "publish" | "unpublish" | "import" | "discard" | "restore"
  action    String
  doc       Json     @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, createdAt])
}

/// The spell book in the database: one row per spell, keyed by name, holding
/// the SpellInfo the cards print (content/rules/spells.json is the seed).
model Spell {
  name      String   @id
  info      Json     @db.Json
  updatedAt DateTime @updatedAt
}

/// The shared world in the database: one survivor record per character per
/// game night (the epilogue's "save to the shared world"), as in content/legacy.
model Survivor {
  /// `<oneshot>/<character>/<yyyy-mm-dd>`
  id        String   @id
  oneshot   String
  data      Json     @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([oneshot])
}
