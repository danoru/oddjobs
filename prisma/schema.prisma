generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One running of one one-shot (phase 11): a GM account runs it, players
/// hold its seats, and the five-letter `code` is read out across the table
/// for in-person play. It plays the one-shot as it was published when the
/// game was made (`content`), so builder edits don't change a game mid-run.
model Game {
  id          String      @id @default(cuid())
  code        String      @unique
  oneshot     String
  /// Who runs it. Null = a table from before accounts: admins only.
  gmId        String?
  gm          User?       @relation("GameGm", fields: [gmId], references: [id], onDelete: SetNull)
  /// "planned" | "open" | "live" | "finished" | "epilogued" (src/lib/games.ts).
  status      String      @default("open")
  scheduledAt DateTime?
  /// How many seats the GM offers; null = one per poster.
  seats       Int?
  /// The published OneShotDoc this game plays, pinned when it was made (or
  /// updated to the latest before it went live). Null = whatever is
  /// published now: the files store, and tables from before games.
  content     Json?       @db.Json
  /// SHA-256 of `content`, to tell whether a newer version has been published.
  contentHash String?
  pinnedAt    DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  coGms       GameCoGm[]
  claims      Claim[]
  deliveries  Delivery[]
  flashbacks  Flashback[]
  state       GameState?
  recordings  Recording[]
  events      TableEvent[]
  epilogue    Epilogue?
  invites     Invite[]
  createdAt   DateTime    @default(now())

  @@index([gmId])
  @@index([oneshot])
}

/// Someone the GM brought in to run the game with them: they see and do
/// everything the GM does, except handing the game on or choosing co-GMs.
model GameCoGm {
  gameId  String
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([gameId, userId])
  @@index([userId])
}

/// The spoiler guard: this person has run (or co-run) this one-shot, so they
/// know its secrets. Kept after a game is handed on: what's read can't be unread.
model Spoiler {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  oneshot String
  at      DateTime @default(now())

  @@id([userId, oneshot])
}

/// A seat: a torn-down poster. The unique (gameId, characterId) pair is the
/// lock: once someone holds a character, nobody else at the game can tear it.
/// An account's seat has `userId`; a guest's has none (a name and the code),
/// until the guest turns it into an account through an invite.
model Claim {
  id          String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  characterId String
  /// The holder's key at this game: `u-<userId>` for an account, the guest
  /// pass's random key for a guest. Never sent to other players.
  playerId    String
  playerName  String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  claimedAt   DateTime @default(now())

  @@unique([gameId, characterId])
  @@index([userId])
}

/// A sealed letter the GM has handed to one character at this game. The
/// text stays in content; this records that it was sent and when it was opened.
/// `letterId` is a content letter id, or `beat:<from>:<n>` for a story beat
/// inherited from a character nobody is playing tonight.
model Delivery {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  letterId    String
  characterId String
  deliveredAt DateTime  @default(now())
  openedAt    DateTime?

  @@unique([gameId, letterId])
}

/// A player's one-sentence answer to their character's session-zero question.
model Flashback {
  id          String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  characterId String
  playerId    String
  answer      String
  updatedAt   DateTime @updatedAt

  @@unique([gameId, characterId])
}

/// Live table play for systems that have it (Ten Candles): the whole game as
/// one JSON state, changed only through the system's reducer
/// (src/systems/<id>/game.ts). `version` guards against two phones acting at
/// once: a write only lands if nobody else wrote since it was read.
model GameState {
  id        String   @id @default(cuid())
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  system    String
  state     Json
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// A player's final words (Ten Candles), kept only when the GM chooses to
/// keep recordings at this game. Small and capped: a short voice clip, or a
/// written message for players without a microphone.
model Recording {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// The recording player's key at this game (as Claim.playerId); never sent to anyone.
  playerId  String
  mime      String
  audio     Bytes?
  text      String?
  size      Int
  createdAt DateTime @default(now())

  @@unique([gameId, playerId])
}

/// Everything that happens at a game outside a system's own game state:
/// dice rolls, notes passed under the table, the GM's bell, act cards,
/// spotlight ticks, rumors drawn, notices pinned to the town board,
/// inspiration coins. One append-only log per game, polled with a cursor
/// (`id`); what each viewer may see is decided by `viewEvent` in
/// src/lib/live.ts, never by the client.
model TableEvent {
  id        Int      @id @default(autoincrement())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  /// roll | note | bell | act | tick | rumor | notice | unpin | coin | spend | hide | death | candle
  kind      String
  /// The acting player's key (as Claim.playerId: `u-<userId>` for an
  /// account); null for the GM. Never sent to anyone.
  byPlayer  String?
  /// The player a note, bell, coin or rumor draw is for; null for the GM or everyone.
  toPlayer  String?
  /// A roll behind the screen: only the GM and the roller see it.
  hidden    Boolean  @default(false)
  data      Json
  createdAt DateTime @default(now())

  @@index([gameId, id])
}

/// The morning after, kept per game so the chronicle can bind every night
/// into one book: the broadsheet (headline, lines, fates) and the GM's edits
/// to the night's tapestry (panels dropped or renamed).
model Epilogue {
  id        String   @id @default(cuid())
  gameId    String   @unique
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  data      Json
  tapestry  Json
  updatedAt DateTime @updatedAt
}

/// Authored content in the database (TEAROFF_STORE=db; src/lib/store/dbStore.ts).
/// One row per one-shot, holding the builder's whole document as JSON: the
/// draft being edited and the version players see. Either may be null, never
/// both. `published` passed every check when it was written; readers parse it
/// again anyway, so a bad row can't render. Documents are `json`, not `jsonb`,
/// so their key order survives (an export reads like the files in git).
model OneShot {
  slug      String            @id
  system    String
  /// "draft" | "published" | "changed", as OneShotStatus.
  status    String
  /// The OneShotDoc being edited; null when there are no unpublished edits.
  draft     Json?             @db.Json
  /// The OneShotDoc players see; null until first published.
  published Json?             @db.Json
  /// Who may edit it in the builder besides the admins (phase 10). Null =
  /// admins only: everything written before accounts, until `admin:create`
  /// hands it to the first admin.
  ownerId   String?
  owner     User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  history   OneShotRevision[]

  @@index([ownerId])
}

/// A one-shot's history: what was saved, published, unpublished, imported,
/// discarded or restored, with the whole document at that moment. Autosaves
/// within a minute of each other share one row. Restoring one makes its
/// document the draft again.
model OneShotRevision {
  id        String   @id @default(cuid())
  slug      String
  oneshot   OneShot  @relation(fields: [slug], references: [slug], onDelete: Cascade)
  /// "save" | "publish" | "unpublish" | "import" | "discard" | "restore"
  action    String
  doc       Json     @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug, createdAt])
}

/// The spell book in the database: one row per spell, keyed by name, holding
/// the SpellInfo the cards print (content/rules/spells.json is the seed).
model Spell {
  name      String   @id
  info      Json     @db.Json
  updatedAt DateTime @updatedAt
}

/// The shared world in the database: one survivor record per character per
/// game night (the epilogue's "save to the shared world"), as in content/legacy.
model Survivor {
  /// `<oneshot>/<character>/<yyyy-mm-dd>`
  id        String   @id
  oneshot   String
  data      Json     @db.Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([oneshot])
}

/// Who owns a one-shot kept as files (the FileStore). content/ is in a public
/// git repo and accounts live in the database, so ownership does too. No row
/// = admins only (everything that was in git before accounts).
model OneShotOwner {
  slug      String   @id
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// A person (phase 10). Sign-in is a username and a password (Auth.js
/// Credentials, JWT sessions, src/auth.ts); there's no email, so a lost
/// password is a one-time reset link an admin hands over. Accounts only come
/// from invites (or the first admin, from `pnpm admin:create`).
model User {
  id            String          @id @default(cuid())
  /// As typed at sign-up.
  username      String
  /// `username` in lower case: the unique key, so "Rook" and "rook" are one person.
  usernameLower String          @unique
  displayName   String
  pronouns      String?
  /// The woodcut on their WANTED poster (/u/<username>): a small PNG data
  /// URL engraved in the browser (src/lib/woodcut.ts). Nothing else is uploaded.
  portrait      String?
  /// Their defaults for reading modes, dice and sound (src/lib/prefs.ts).
  /// Null = never saved: the browser's own, as for guests.
  prefs         Json?
  /// argon2id.
  passwordHash  String
  /// "admin" | "member". Per-game roles (GM, co-GM, player) live on each game.
  role          String          @default("member")
  /// The author badge: may write one-shots in the builder (only their own).
  author        Boolean         @default(false)
  /// May make invite links (admins always can).
  canInvite     Boolean         @default(false)
  disabledAt    DateTime?
  /// Bumped to end every session at once (disabled, password changed or
  /// reset, role changed): a session carries the version it started with.
  tokenVersion  Int             @default(0)
  lastLoginAt   DateTime?
  invitedById   String?
  invitedBy     User?           @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invited       User[]          @relation("InvitedBy")
  inviteId      String?
  invite        Invite?         @relation("JoinedWith", fields: [inviteId], references: [id], onDelete: SetNull)
  invitesMade   Invite[]        @relation("InviteMaker")
  resets        PasswordReset[] @relation("ResetFor")
  resetsMade    PasswordReset[] @relation("ResetMaker")
  oneShots      OneShot[]
  fileOneShots  OneShotOwner[]
  gamesRun      Game[]          @relation("GameGm")
  coGmOf        GameCoGm[]
  seats         Claim[]
  spoilers      Spoiler[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

/// An invite link, `/join/<code>`: single- or multi-use, with an expiry, and
/// optionally the author badge for whoever joins with it. A GM can make one
/// for a guest seat: whoever joins with it takes that seat (and its history).
model Invite {
  id           String    @id @default(cuid())
  code         String    @unique
  /// Who it's for, to tell links apart in the list ("for Sam").
  note         String?
  maxUses      Int       @default(1)
  uses         Int       @default(0)
  expiresAt    DateTime
  grantsAuthor Boolean   @default(false)
  revokedAt    DateTime?
  createdById  String?
  createdBy    User?     @relation("InviteMaker", fields: [createdById], references: [id], onDelete: SetNull)
  joined       User[]    @relation("JoinedWith")
  /// A guest seat to hand over: the game, and the guest key it was played under.
  guestGameId  String?
  guestGame    Game?     @relation(fields: [guestGameId], references: [id], onDelete: SetNull)
  guestKey     String?
  createdAt    DateTime  @default(now())
}

/// A one-time password reset link, `/reset/<token>`, made by an admin and
/// handed over by hand. Only the token's SHA-256 is kept.
model PasswordReset {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation("ResetFor", fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("ResetMaker", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// A failed sign-in, reset or join, for rate limiting that holds across
/// serverless instances (src/lib/rateLimit.ts). Rows older than a day are
/// pruned as new ones arrive.
model AuthAttempt {
  id        Int      @id @default(autoincrement())
  /// "login:user:<username>", "login:ip:<hash>", "reset:ip:<hash>" or "join:ip:<hash>"
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
