        "name": "Divine Order: Protector",
        "source": "class",
        "text": "Trained for battle: you have Martial weapon and Heavy armor training."
      },
      {
        "name": "Channel Divinity",
        "source": "class",
        "text": "Two uses; regain one on a Short Rest and all on a Long Rest. Options: Divine Spark, Turn Undead, Preserve Life.",
        "uses": {
          "max": 2,
          "per": "long"
        }
      },
      {
        "name": "Divine Spark",
        "source": "class",
        "text": "Magic action: point your holy symbol at a creature within 30 ft. Roll 1d8 + 3 and either heal it that much or deal that much Necrotic or Radiant damage (Con save for half)."
      },
      {
        "name": "Turn Undead",
        "source": "class",
        "text": "Magic action: each Undead of your choice within 30 ft makes a Wis save against your spell DC or is Frightened and Incapacitated for 1 minute (ends if it takes damage)."
      },
      {
        "name": "Disciple of Life",
        "source": "subclass",
        "text": "When a spell you cast with a slot restores HP, the target regains extra HP equal to 2 + the slot level."
      },
      {
        "name": "Preserve Life",
        "source": "subclass",
        "text": "Channel Divinity: restore up to 15 HP, divided among creatures within 30 ft who are Bloodied (none can be raised above half their HP max)."
      },
      {
        "name": "Healer: Battle Medic",
        "source": "feat",
        "text": "Utilize action with a Healer's Kit: a creature within reach can spend one Hit Die; it regains that roll + 2 HP. You also reroll any 1s on healing dice."
      },
      {
        "name": "Magic Initiate",
        "source": "feat",
        "text": "Light and Thaumaturgy cantrips; cast Sanctuary once per Long Rest without a slot.",
        "uses": {
